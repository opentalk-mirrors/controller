{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "reviewers": [
    "@opentalk/tools/renovate-reviewers/backend"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": [
        "opentelemetry*"
      ],
      "groupName": "opentelemetry-rs",
      "groupSlug": "opentelemetry-rs"
    },
    {
      "matchPackagePatterns": [
        "/^opentalk-types/"
      ],
      "groupName": "opentalk-types",
      "groupSlug": "opentalk-types"
    },
    {
      "matchPackagePatterns": [
        "/^opentalk-roomserver/"
      ],
      "groupName": "opentalk-roomserver",
      "groupSlug": "opentalk-roomserver"
    },
    {
      "matchPackagePatterns": [
        "/^livekit/"
      ],
      "groupName": "livekit",
      "groupSlug": "livekit"
    }
  ],
  "ignoreDeps": [
    "actix-web-actors"
  ]
}
