{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "reviewers": [
    "@opentalk/tools/renovate-reviewers/backend"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "opentelemetry*"
      ],
      "groupName": "opentelemetry-rs",
      "groupSlug": "opentelemetry-rs"
    },
    {
      "matchPackageNames": [
        "/^opentalk/"
      ],
      "groupName": "opentalk",
      "groupSlug": "opentalk"
    },
    {
      "matchPackageNames": [
        "/^livekit/"
      ],
      "groupName": "livekit",
      "groupSlug": "livekit"
    }
  ],
  "ignoreDeps": [
    "actix-web-actors"
  ]
}
